# Public media origin/path only, never credentials. Leave empty until media is hosted.
# Existing filenames from backend/videos/ must be preserved by the future host.
VITE_MEDIA_BASE_URL=

# Server-only values, provisioned through Vercel; never use a VITE_ prefix.
MEDIA_STORE_ID=
PRIVATE_STORE_ID=
STAFF_USER=
STAFF_PASSWORD_HASH=
# VERCEL_OIDC_TOKEN is issued by Vercel; do not hardcode it.
